{
  "name": "02_Lottery_and_Winner_DM",
  "nodes": [
    {
      "parameters": {},
      "id": "c2a11111-1111-1111-1111-111111111111",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "formTitle": "抽選設定",
        "formFields": {
          "values": [
            {"fieldLabel": "campaign_id", "fieldType": "text", "requiredField": true},
            {"fieldLabel": "winners", "fieldType": "number", "requiredField": true},
            {"fieldLabel": "dry_run", "fieldType": "dropdown", "fieldOptions": {"values": [{"option": "true"}, {"option": "false"}]}, "requiredField": true}
          ]
        }
      },
      "id": "c2a22222-2222-2222-2222-222222222222",
      "name": "Ask Params",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2,
      "position": [420, 300]
    },
    {
      "parameters": {
        "operation": "get",
        "sheetName": "={{$env.GSHEET_APPLICANTS_ID}}",
        "filtersUI": {
          "values": [
            {"lookupColumn": "campaign_id", "lookupValue": "={{$json[\"campaign_id\"]}}"},
            {"lookupColumn": "status", "lookupValue": "entered"}
          ]
        },
        "options": {"returnAllMatches": true}
      },
      "id": "c2a33333-3333-3333-3333-333333333333",
      "name": "Load Applicants",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [640, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {"id": "GSHEETS_CRED", "name": "Google Sheets OAuth"}
      }
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "applicants",
        "options": {}
      },
      "id": "c2a44444-4444-4444-4444-444444444444",
      "name": "Aggregate",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [860, 300]
    },
    {
      "parameters": {
        "functionCode": "const params = $('Ask Params').item.json;\nconst applicants = $json.applicants || [];\n// dedupe by author_id so one user cannot win multiple times\nconst uniq = Object.values(Object.fromEntries(applicants.map(a => [a.author_id, a])));\n// Fisher-Yates shuffle\nfor (let i = uniq.length - 1; i > 0; i--) {\n  const j = Math.floor(Math.random() * (i + 1));\n  [uniq[i], uniq[j]] = [uniq[j], uniq[i]];\n}\nconst n = Math.min(Number(params.winners) || 1, uniq.length);\nconst winners = uniq.slice(0, n).map(w => ({ ...w, status: 'winner', dry_run: String(params.dry_run) === 'true' }));\nreturn winners.map(json => ({ json }));"
      },
      "id": "c2a55555-5555-5555-5555-555555555555",
      "name": "Draw Winners",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1080, 300]
    },
    {
      "parameters": {
        "operation": "update",
        "sheetName": "={{$env.GSHEET_APPLICANTS_ID}}",
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": ["tweet_id"],
          "value": {
            "tweet_id": "={{$json[\"tweet_id\"]}}",
            "status": "winner",
            "drawn_at": "={{$now.toISO()}}"
          }
        }
      },
      "id": "c2a66666-6666-6666-6666-666666666666",
      "name": "Mark Winner",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [1300, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {"id": "GSHEETS_CRED", "name": "Google Sheets OAuth"}
      }
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {"leftValue": "={{$json[\"dry_run\"]}}", "rightValue": false, "operator": {"type": "boolean", "operation": "equals"}}
          ]
        }
      },
      "id": "c2a77777-7777-7777-7777-777777777777",
      "name": "Actually Send?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1520, 300]
    },
    {
      "parameters": {
        "url": "=https://api.twitter.com/2/dm_conversations/with/{{$json[\"author_id\"]}}/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "twitterOAuth2Api",
        "method": "POST",
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={\n  \"text\": \"🎉 ご当選おめでとうございます！\\n\\n『副業ノウハウプレゼント』キャンペーンにご応募いただきありがとうございました。\\n特典の受け取りリンクはこちらです👇\\nhttps://example.com/receive?u={{$json[\"author_id\"]}}\\n\\n※48時間以内にアクセスしてください。\"\n}",
        "options": {}
      },
      "id": "c2a88888-8888-8888-8888-888888888888",
