# n8n上で Credentials として設定するものは除き、$env. で参照する値のみ列挙

# X (Twitter) API - 投稿/DMに使うユーザーID
X_USER_ID=1234567890

# 販売用のチェックアウトLP (Stripe / Shopify / LP等)
# DMでは ?ref={author_id}&utm_source=... が付与される
CHECKOUT_BASE_URL=https://example.com/checkout

# n8n Credentials側で登録すべき項目 (参考):
#  - twitterOAuth2Api   : X OAuth2 (tweet.read, tweet.write, dm.write, users.read)
#  - supabaseApi        : SUPABASE_URL + SERVICE_ROLE_KEY
#  - openAiApi          : OPENAI_API_KEY
#  - slackApi           : Slack Bot Token (chat:write)
#  - stripeSignature    : Webhookノードの HMAC 検証用シークレット (任意)
