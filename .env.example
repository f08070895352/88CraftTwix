# n8n上で Credentials として設定するものは除き、$env. で参照する値のみ列挙

# X (Twitter) API - 投稿/DMに使うユーザーID
X_USER_ID=1234567890

# 販売用のチェックアウトLP (Stripe / Shopify / LP等)
# DMでは ?ref={author_id}&utm_source=... が付与される
# 同梱の stripe-checkout-session-creator.json を使う場合は n8n の /webhook/checkout を指す
CHECKOUT_BASE_URL=https://example.com/checkout

# Stripe Checkout Session Creator が使う値
STRIPE_PRICE_ID=price_xxxxxxxxxxxx
STRIPE_COUPON_ID=promo_xxxxxxxxxxxx
SUCCESS_URL=https://example.com/thanks
CANCEL_URL=https://example.com/cancel

# 新規フォロワーへ送るウェルカムDMで紹介するLP
WELCOME_LP_URL=https://example.com/welcome

# Stripe Webhook署名検証用 (Stripe Dashboard > Webhooks > Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Supabase 役割分離
# n8n のSupabase Credentialには n8n_writer ロールの JWT を設定すること
# Service Role Key は絶対に n8n の通常クレデンシャルには使わない
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_N8N_WRITER_JWT=eyJhbGc...

# キャンペーン横断モジュール
LINE_CHANNEL_SECRET=xxxxxxxxxxxxxxxx
LINE_DEFAULT_CAMPAIGN_ID=c_line_default
X_TREND_WOEID=23424856
BUSINESS_ONE_LINER=（自社事業の30字要約）

# n8n Credentials側で登録すべき項目 (参考):
#  - twitterOAuth2Api   : X OAuth2 (tweet.read, tweet.write, dm.write, users.read)
#  - supabaseApi        : SUPABASE_URL + SERVICE_ROLE_KEY
#  - openAiApi          : OPENAI_API_KEY
#  - slackApi           : Slack Bot Token (chat:write)
#  - stripeSignature    : Webhookノードの HMAC 検証用シークレット (任意)
